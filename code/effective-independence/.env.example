# Copy this file to .env and fill in real keys. Never commit .env.

# Active providers (all free-tier as of Aug 2026 — see config/models.yaml):
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Required only for the gated GPQA-Diamond dataset (Idavidrein/gpqa on HuggingFace).
# You must also accept the dataset's terms of use on huggingface.co before this works.
HF_TOKEN=

# Not currently used (original model set required a funded Anthropic account) —
# kept here in case the project owner later adds paid API budget.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TOGETHER_API_KEY=
