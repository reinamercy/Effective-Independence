.env
cache/
figures/*
!figures/.gitkeep

# Dataset content is never committed: GPQA-Diamond's terms of use explicitly
# prohibit publishing its examples in plain text online (anti-contamination),
# and there's no reason to duplicate MATH/SimpleQA content in git either.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Runtime-generated logs (grow continuously, may contain raw model output) --
# logs/decisions.md is the only hand-written log file and stays tracked.
logs/*.jsonl
logs/*.txt

# LaTeX build artifacts, regenerated by each pdflatex run. paper/main.pdf is
# deliberately NOT ignored -- the compiled output is what the owner reviews.
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.synctex.gz

__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/
.DS_Store
